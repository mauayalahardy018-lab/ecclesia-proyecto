{
  "name": "ecclesia-sistema-nacional",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "geo:download": "node scripts/download-inegi.js",
    "db:embedded": "node scripts/embedded-db.js",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "test": "vitest run",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration.test.js",
    "coverage": "vitest run --coverage",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "api:validate": "node scripts/validate-openapi.js",
    "check": "npm run lint && npm run format:check && npm run deps:check && npm run api:validate && npm run test && npm run coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
